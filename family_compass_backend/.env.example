# Persistent SQLite by default. PostgreSQL URLs are also accepted.
DATABASE_URL=sqlite+pysqlite:///./.data/family_compass.db
FAMILY_COMPASS_SEED_DEMO_DATA=true

# disabled | dev | firebase | firebase_local_test
FAMILY_COMPASS_AUTH_MODE=dev
# Generate at least 32 random bytes. Do not commit the generated secret.
FAMILY_COMPASS_DEV_AUTH_SECRET=
FIREBASE_PROJECT_ID=
# `firebase` always uses Firebase Admin credentials and checks revocation.
# `firebase_local_test` verifies Google signatures without Admin credentials,
# accepts only one fictional phone digest, and cannot check revocation. Use it
# only on an isolated local test server with no real-family data.
FAMILY_COMPASS_FIREBASE_LOCAL_TEST_PHONE_SHA256=
# Use Application Default Credentials or a deployment secret mount. Never place
# a service-account JSON file in this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
# For local Firebase Auth emulator use, for example: 127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=
# memory | fcm
FAMILY_COMPASS_NOTIFICATION_PROVIDER=memory

# mock | lm_studio | openai_compatible
FAMILY_COMPASS_AI_PROVIDER=mock
FAMILY_COMPASS_AI_MODEL=google/gemma-3-4b
FAMILY_COMPASS_AI_TIMEOUT_SECONDS=25
FAMILY_COMPASS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8091,http://localhost:8091
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Used only when FAMILY_COMPASS_AI_PROVIDER=openai_compatible
FAMILY_COMPASS_AI_BASE_URL=
FAMILY_COMPASS_AI_API_KEY=
